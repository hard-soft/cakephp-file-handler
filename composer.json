{
  "name": "hard-soft/cakephp-file-handler",
  "description": "Encode, upload, Parse, import CSV files",
  "type": "cakephp-plugin",
  "keywords": ["csv", "encoding", "utf8", "utf16", "utf7", "import", "cake3"],
  "authors": [
    {
      "name": "Daniel Spöck",
      "role": "Author"
    }
  ],
  "require": {
    "cakephp/cakephp": "^4.0",
    "league/csv": "^9.8"
  },
  "autoload": {
      "psr-4": {
          "FileHandler\\": "src/"
      }
  },
  "autoload-dev": {
      "psr-4": {
          "FileHandler\\Test\\": "tests",
          "Cake\\Test\\": "./vendor/cakephp/cakephp/tests"
      }
  }
} 
